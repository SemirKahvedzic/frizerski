# Copy to .env and adjust. All variables are validated at boot by src/lib/env.ts.

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=Bookly
LOG_LEVEL=debug

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/salon?schema=public
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5433/salon_test?schema=public
DATABASE_POOL_MAX=10

# --- Worker ---
WORKER_HEALTH_PORT=3001
# Background jobs (pg-boss lives in its own schema inside DATABASE_URL)
PGBOSS_SCHEMA=pgboss
OUTBOX_POLL_MS=2000

# --- Rate limiting / cache ---
RATE_LIMIT_PROVIDER=memory

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-please-32-chars-min
# Defaults to APP_URL when omitted
BETTER_AUTH_URL=http://localhost:3000
# Optional; Google sign-in is enabled only when both are set
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email ---
# smtp (Mailpit in dev) | console (log only) | fake (tests)
# Images: local (filesystem, served by /api/v1/media) | s3 (R2, AWS, MinIO) | fake (tests)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=salon-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/salon-media
MAX_UPLOAD_MB=10

# Web push: webpush | fake | off. Generate keys with: pnpm push:vapid
PUSH_PROVIDER=off
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# smtp | resend | console | fake
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
EMAIL_FROM="Bookly <no-reply@localhost>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# --- Seed (development only) ---
SEED_SUPER_ADMIN_EMAIL=admin@platform.local
SEED_SUPER_ADMIN_PASSWORD=Admin12345!

# --- Testing ---
# Set to "off" only when running automated E2E suites against this instance
AUTH_RATE_LIMIT=on
