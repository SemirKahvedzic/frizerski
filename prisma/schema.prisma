// Prisma schema. Full design: docs/database.md
// Models are added phase by phase. Raw SQL that Prisma cannot express
// (extensions, exclusion constraint, composite FKs) lives in prisma/migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Convention: every DateTime is `@db.Timestamptz(3)` (UTC instant), never a
// naive timestamp. Wall-clock schedule times are `String` "HH:mm".

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PlatformRole {
  SUPER_ADMIN
}

enum SalonRole {
  OWNER
  ADMIN
  EMPLOYEE
}

enum Audience {
  MALE
  FEMALE
  UNISEX
}

enum SalonStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TimeOffType {
  VACATION
  SICK
  PERSONAL
  OTHER
}

enum BlockedTimeSource {
  MANUAL
  EXTERNAL
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  ONLINE
  ADMIN
  WALK_IN
}

enum PaymentStatus {
  NONE
  PENDING
  PAID
  REFUNDED
}

enum ReminderKind {
  H24
  H1
}

enum ReminderStatus {
  SCHEDULED
  SENT
  CANCELLED
  SKIPPED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum NotificationChannel {
  EMAIL
  PUSH
  IN_APP
}

enum NotificationType {
  BOOKING_PENDING
  BOOKING_CONFIRMED
  BOOKING_RESCHEDULED
  BOOKING_CANCELLED
  REMINDER_24H
  REMINDER_1H
  STAFF_NEW_BOOKING
  STAFF_BOOKING_RESCHEDULED
  STAFF_BOOKING_CANCELLED
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

// ---------------------------------------------------------------------------
// Identity (Better Auth core tables + application fields)
// ---------------------------------------------------------------------------

model User {
  id            String        @id @default(uuid(7))
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false) @map("email_verified")
  image         String?
  firstName     String?       @map("first_name")
  lastName      String?       @map("last_name")
  phone         String?
  locale        String?
  platformRole  PlatformRole? @map("platform_role")
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions    Session[]
  accounts    Account[]
  memberships SalonMembership[]
  invitations SalonMembership[] @relation("MembershipInvitedBy")
  auditLogs   AuditLog[]
  closures    SalonClosure[]
  employees   Employee[]
  customers   Customer[]
  bookingsCreated   Booking[]              @relation("BookingCreatedBy")
  bookingsCancelled Booking[]              @relation("BookingCancelledBy")
  statusChanges     BookingStatusHistory[]
  notificationPreference NotificationPreference?
  notifications          Notification[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7))
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid(7))
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid(7))
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// Tenant root
// ---------------------------------------------------------------------------

model Salon {
  id            String      @id @default(uuid(7))
  slug          String      @unique
  name          String
  description   String?
  /// Free-form category key, e.g. barbershop, hair-salon, beauty-salon.
  category      String?
  audience      Audience    @default(UNISEX)
  address       String?
  city          String?
  postalCode    String?     @map("postal_code")
  /// ISO 3166-1 alpha-2
  country       String?
  latitude      Float?
  longitude     Float?
  googleMapsUrl String?     @map("google_maps_url")
  phone         String?
  email         String?
  website       String?
  instagram     String?
  facebook      String?
  tiktok        String?
  brandColor    String?     @map("brand_color")
  timezone      String      @default("Europe/Sarajevo")
  currency      String      @default("BAM")
  defaultLocale String      @default("bs") @map("default_locale")
  status        SalonStatus @default(ACTIVE)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  settings     SalonSettings?
  workingHours SalonWorkingHours[]
  closures     SalonClosure[]
  memberships  SalonMembership[]
  auditLogs    AuditLog[]
  employees    Employee[]
  schedules    EmployeeSchedule[]
  breaks       EmployeeBreak[]
  timeOff      EmployeeTimeOff[]
  blockedTimes BlockedTime[]
  categories   ServiceCategory[]
  services     Service[]
  employeeServices EmployeeService[]
  customers      Customer[]
  bookings       Booking[]
  bookingHistory BookingStatusHistory[]
  reminders      BookingReminder[]
  accessTokens   BookingAccessToken[]
  outboxEvents   OutboxEvent[]
  notifications  Notification[]

  @@index([status])
  @@map("salons")
}

// ---------------------------------------------------------------------------
// Staff (docs/database.md §4.3)
// ---------------------------------------------------------------------------

model Employee {
  id               String   @id @default(uuid(7))
  salonId          String   @map("salon_id")
  /// Set when the employee has a login (linked through SalonMembership).
  userId           String?  @map("user_id")
  firstName        String   @map("first_name")
  lastName         String   @map("last_name")
  position         String?
  bio              String?
  email            String?
  phone            String?
  audience         Audience @default(UNISEX)
  /// Calendar color (hex)
  color            String?
  isActive         Boolean  @default(true) @map("is_active")
  isBookableOnline Boolean  @default(true) @map("is_bookable_online")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  salon     Salon              @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user      User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  schedules EmployeeSchedule[]
  timeOff   EmployeeTimeOff[]
  services  EmployeeService[]
  bookings  Booking[]

  @@unique([salonId, id])
  @@index([salonId, isActive, sortOrder])
  @@map("employees")
}

// ---------------------------------------------------------------------------
// Catalog (docs/database.md §4.4)
// ---------------------------------------------------------------------------

model ServiceCategory {
  id        String   @id @default(uuid(7))
  salonId   String   @map("salon_id")
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  salon    Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  services Service[]

  @@unique([salonId, id])
  @@unique([salonId, name])
  @@map("service_categories")
}

model Service {
  id                 String   @id @default(uuid(7))
  salonId            String   @map("salon_id")
  categoryId         String?  @map("category_id")
  name               String
  description        String?
  /// Minor units (e.g. cents / feninga)
  priceCents         Int      @map("price_cents")
  currency           String
  durationMinutes    Int      @map("duration_minutes")
  bufferAfterMinutes Int      @default(0) @map("buffer_after_minutes")
  audience           Audience @default(UNISEX)
  isActive           Boolean  @default(true) @map("is_active")
  sortOrder          Int      @default(0) @map("sort_order")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  salon     Salon             @relation(fields: [salonId], references: [id], onDelete: Cascade)
  category  ServiceCategory?  @relation(fields: [salonId, categoryId], references: [salonId, id], onDelete: SetNull)
  employees EmployeeService[]
  bookings  Booking[]

  @@unique([salonId, id])
  @@index([salonId, categoryId, sortOrder])
  @@index([salonId, isActive])
  @@map("services")
}

/// Which employees provide which services, with optional overrides.
model EmployeeService {
  id                      String   @id @default(uuid(7))
  salonId                 String   @map("salon_id")
  employeeId              String   @map("employee_id")
  serviceId               String   @map("service_id")
  priceOverrideCents      Int?     @map("price_override_cents")
  durationOverrideMinutes Int?     @map("duration_override_minutes")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  salon    Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [salonId, employeeId], references: [salonId, id], onDelete: Cascade)
  service  Service  @relation(fields: [salonId, serviceId], references: [salonId, id], onDelete: Cascade)

  @@unique([employeeId, serviceId])
  @@unique([salonId, id])
  @@index([serviceId])
  @@map("employee_services")
}

/// Recurring weekly working interval. Several rows per weekday = split shifts.
model EmployeeSchedule {
  id         String    @id @default(uuid(7))
  salonId    String    @map("salon_id")
  employeeId String    @map("employee_id")
  /// 0 = Monday … 6 = Sunday
  weekday    Int
  startTime  String    @map("start_time")
  endTime    String    @map("end_time")
  validFrom  DateTime? @map("valid_from") @db.Date
  validUntil DateTime? @map("valid_until") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  salon    Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  employee Employee        @relation(fields: [salonId, employeeId], references: [salonId, id], onDelete: Cascade)
  breaks   EmployeeBreak[]

  @@unique([salonId, id])
  @@index([employeeId, weekday])
  @@map("employee_schedules")
}

/// Recurring break inside a schedule interval.
model EmployeeBreak {
  id         String  @id @default(uuid(7))
  salonId    String  @map("salon_id")
  scheduleId String  @map("schedule_id")
  startTime  String  @map("start_time")
  endTime    String  @map("end_time")
  label      String?

  salon    Salon            @relation(fields: [salonId], references: [id], onDelete: Cascade)
  schedule EmployeeSchedule @relation(fields: [salonId, scheduleId], references: [salonId, id], onDelete: Cascade)

  @@unique([salonId, id])
  @@map("employee_breaks")
}

/// Multi-day or partial-day absence.
model EmployeeTimeOff {
  id          String      @id @default(uuid(7))
  salonId     String      @map("salon_id")
  employeeId  String      @map("employee_id")
  type        TimeOffType
  startsAt    DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime    @map("ends_at") @db.Timestamptz(3)
  allDay      Boolean     @default(true) @map("all_day")
  reason      String?
  createdById String?     @map("created_by_id")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  salon    Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [salonId, employeeId], references: [salonId, id], onDelete: Cascade)

  @@unique([salonId, id])
  @@index([employeeId, startsAt, endsAt])
  @@map("employee_time_off")
}

/// Ad-hoc block for one employee (employeeId set) or the whole salon (null).
/// The composite FK to Employee is added in raw SQL (nullable column).
model BlockedTime {
  id          String            @id @default(uuid(7))
  salonId     String            @map("salon_id")
  employeeId  String?           @map("employee_id")
  startsAt    DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime          @map("ends_at") @db.Timestamptz(3)
  reason      String?
  source      BlockedTimeSource @default(MANUAL)
  externalRef String?           @map("external_ref")
  createdById String?           @map("created_by_id")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([salonId, id])
  @@index([salonId, employeeId, startsAt])
  @@map("blocked_times")
}

/// Booking and notification policy; one row per salon (docs/database.md §4.2).
model SalonSettings {
  salonId                    String   @id @map("salon_id")
  slotIntervalMinutes        Int      @default(30) @map("slot_interval_minutes")
  minBookingNoticeMinutes    Int      @default(60) @map("min_booking_notice_minutes")
  maxBookingAdvanceDays      Int      @default(60) @map("max_booking_advance_days")
  cancellationCutoffHours    Int      @default(12) @map("cancellation_cutoff_hours")
  rescheduleCutoffHours      Int      @default(12) @map("reschedule_cutoff_hours")
  autoConfirmBookings        Boolean  @default(true) @map("auto_confirm_bookings")
  bufferMinutes              Int      @default(0) @map("buffer_minutes")
  allowAnyEmployee           Boolean  @default(true) @map("allow_any_employee")
  allowGuestBooking          Boolean  @default(true) @map("allow_guest_booking")
  requirePhone               Boolean  @default(true) @map("require_phone")
  emailNotificationsEnabled  Boolean  @default(true) @map("email_notifications_enabled")
  pushNotificationsEnabled   Boolean  @default(true) @map("push_notifications_enabled")
  notifyAdminsOnNewBooking   Boolean  @default(true) @map("notify_admins_on_new_booking")
  notifyEmployeeOnNewBooking Boolean  @default(true) @map("notify_employee_on_new_booking")
  reminder24hEnabled         Boolean  @default(true) @map("reminder_24h_enabled")
  reminder1hEnabled          Boolean  @default(true) @map("reminder_1h_enabled")
  updatedAt                  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@map("salon_settings")
}

/// Public opening hours; the outer bound for every employee schedule.
model SalonWorkingHours {
  id       String  @id @default(uuid(7))
  salonId  String  @map("salon_id")
  /// 0 = Monday … 6 = Sunday (ISO)
  weekday  Int
  /// "HH:mm"
  opensAt  String  @map("opens_at")
  /// "HH:mm", may be "24:00"
  closesAt String  @map("closes_at")
  isClosed Boolean @default(false) @map("is_closed")

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([salonId, weekday])
  @@unique([salonId, id])
  @@map("salon_working_hours")
}

/// Whole-salon holidays / closures (inclusive date range).
model SalonClosure {
  id          String   @id @default(uuid(7))
  salonId     String   @map("salon_id")
  startsOn    DateTime @map("starts_on") @db.Date
  endsOn      DateTime @map("ends_on") @db.Date
  reason      String?
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  salon     Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([salonId, id])
  @@index([salonId, startsOn])
  @@map("salon_closures")
}

/// Assigns a salon role to a user. A user may hold roles in several salons.
model SalonMembership {
  id          String    @id @default(uuid(7))
  userId      String    @map("user_id")
  salonId     String    @map("salon_id")
  role        SalonRole
  /// Set when role = EMPLOYEE (composite FK to Employee added in the staff phase).
  employeeId  String?   @map("employee_id")
  invitedById String?   @map("invited_by_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  salon     Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)
  invitedBy User? @relation("MembershipInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([userId, salonId])
  /// Tenant-integrity key: lets other tables reference (salonId, id) with a composite FK.
  @@unique([salonId, id])
  @@index([salonId, role])
  @@map("salon_memberships")
}

// ---------------------------------------------------------------------------
// Customers and bookings (docs/database.md §4.5, docs/booking-system.md)
// ---------------------------------------------------------------------------

/// Per-salon customer record. Guests have userId = null.
model Customer {
  id             String    @id @default(uuid(7))
  salonId        String    @map("salon_id")
  userId         String?   @map("user_id")
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  email          String
  phone          String?
  notes          String?
  marketingOptIn Boolean   @default(false) @map("marketing_opt_in")
  firstBookingAt DateTime? @map("first_booking_at") @db.Timestamptz(3)
  lastBookingAt  DateTime? @map("last_booking_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  salon    Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookings Booking[]

  @@unique([salonId, id])
  @@unique([salonId, email])
  @@index([salonId, lastName, firstName])
  @@index([salonId, phone])
  @@index([userId])
  @@map("customers")
}

model Booking {
  id                  String        @id @default(uuid(7))
  salonId             String        @map("salon_id")
  customerId          String        @map("customer_id")
  employeeId          String        @map("employee_id")
  serviceId           String        @map("service_id")
  status              BookingStatus
  startsAt            DateTime      @map("starts_at") @db.Timestamptz(3)
  /// Includes the buffer: startsAt + durationMinutes + bufferMinutes
  endsAt              DateTime      @map("ends_at") @db.Timestamptz(3)
  durationMinutes     Int           @map("duration_minutes")
  bufferMinutes       Int           @default(0) @map("buffer_minutes")
  priceCents          Int           @map("price_cents")
  currency            String
  serviceNameSnapshot String        @map("service_name_snapshot")
  source              BookingSource @default(ONLINE)
  paymentStatus       PaymentStatus @default(NONE) @map("payment_status")
  clientNotes         String?       @map("client_notes")
  internalNotes       String?       @map("internal_notes")
  cancelledAt         DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelledById       String?       @map("cancelled_by_id")
  /// CLIENT | GUEST | SALON | SYSTEM
  cancelledBy         String?       @map("cancelled_by")
  cancellationReason  String?       @map("cancellation_reason")
  /// Optimistic concurrency; bumped on every mutation.
  version             Int           @default(1)
  createdById         String?       @map("created_by_id")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  salon           Salon                  @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customer        Customer               @relation(fields: [salonId, customerId], references: [salonId, id], onDelete: Restrict)
  employee        Employee               @relation(fields: [salonId, employeeId], references: [salonId, id], onDelete: Restrict)
  service         Service                @relation(fields: [salonId, serviceId], references: [salonId, id], onDelete: Restrict)
  createdBy       User?                  @relation("BookingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledByUser User?                  @relation("BookingCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  history         BookingStatusHistory[]
  reminders       BookingReminder[]
  accessTokens    BookingAccessToken[]

  @@unique([salonId, id])
  @@index([salonId, startsAt])
  @@index([employeeId, startsAt])
  @@index([customerId, startsAt])
  @@index([salonId, status, startsAt])
  @@map("bookings")
}

model BookingStatusHistory {
  id               String         @id @default(uuid(7))
  salonId          String         @map("salon_id")
  bookingId        String         @map("booking_id")
  fromStatus       BookingStatus? @map("from_status")
  toStatus         BookingStatus  @map("to_status")
  /// CREATED | STATUS_CHANGED | RESCHEDULED | CANCELLED
  action           String
  previousStartsAt DateTime?      @map("previous_starts_at") @db.Timestamptz(3)
  newStartsAt      DateTime?      @map("new_starts_at") @db.Timestamptz(3)
  changedById      String?        @map("changed_by_id")
  /// CLIENT | GUEST | SALON | SYSTEM
  changedBy        String         @map("changed_by")
  reason           String?
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  salon         Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  booking       Booking @relation(fields: [salonId, bookingId], references: [salonId, id], onDelete: Cascade)
  changedByUser User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@unique([salonId, id])
  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

/// Source of truth for reminder scheduling and idempotency (docs/notifications.md §5).
model BookingReminder {
  id           String         @id @default(uuid(7))
  salonId      String         @map("salon_id")
  bookingId    String         @map("booking_id")
  kind         ReminderKind
  scheduledFor DateTime       @map("scheduled_for") @db.Timestamptz(3)
  status       ReminderStatus @default(SCHEDULED)
  jobId        String?        @map("job_id")
  sentAt       DateTime?      @map("sent_at") @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  salon   Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [salonId, bookingId], references: [salonId, id], onDelete: Cascade)

  @@unique([bookingId, kind, scheduledFor])
  @@unique([salonId, id])
  @@index([status, scheduledFor])
  @@map("booking_reminders")
}

/// Guest management links (hashed at rest).
model BookingAccessToken {
  id         String    @id @default(uuid(7))
  salonId    String    @map("salon_id")
  bookingId  String    @map("booking_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  salon   Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [salonId, bookingId], references: [salonId, id], onDelete: Cascade)

  @@unique([salonId, id])
  @@map("booking_access_tokens")
}

/// Transactional outbox (docs/architecture.md §10).
model OutboxEvent {
  id            String       @id @default(uuid(7))
  salonId       String?      @map("salon_id")
  type          String
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  occurredAt    DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz(3)
  lastError     String?      @map("last_error")

  salon Salon? @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([status, occurredAt])
  @@map("outbox_events")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Append-only record of admin and platform actions (docs/database.md §4.8).
model AuditLog {
  id          String   @id @default(uuid(7))
  /// Null for platform-level actions.
  salonId     String?  @map("salon_id")
  actorUserId String?  @map("actor_user_id")
  /// USER | SYSTEM | GUEST
  actorType   String   @map("actor_type")
  /// Dotted verb, e.g. `salon.created`, `service.priceChanged`.
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  before      Json?
  after       Json?
  metadata    Json?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  requestId   String?  @map("request_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  salon Salon? @relation(fields: [salonId], references: [id], onDelete: SetNull)
  actor User?  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([salonId, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Platform
// ---------------------------------------------------------------------------

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_settings")
}

/// Per-user notification preferences (docs/database.md). Created lazily; users
/// without a row get the defaults in code.
model NotificationPreference {
  userId          String   @id @map("user_id")
  emailEnabled    Boolean  @default(true) @map("email_enabled")
  pushEnabled     Boolean  @default(false) @map("push_enabled")
  reminder24h     Boolean  @default(true) @map("reminder_24h")
  reminder1h      Boolean  @default(true) @map("reminder_1h")
  marketingEmails Boolean  @default(false) @map("marketing_emails")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/// One delivery attempt per (booking, type, channel, recipient, version):
/// `dedupeKey` makes the dispatcher idempotent (docs/notifications.md §4).
/// `bookingId` is a plain reference (no FK) so the log survives a
/// booking's lifecycle independently; rows are removed with the salon.
model Notification {
  id                String              @id @default(uuid(7))
  salonId           String?             @map("salon_id")
  bookingId         String?             @map("booking_id")
  userId            String?             @map("user_id")
  customerId        String?             @map("customer_id")
  channel           NotificationChannel
  type              NotificationType
  status            NotificationStatus  @default(QUEUED)
  /// Email address, push subscription id or user id, depending on channel.
  recipient         String
  locale            String
  subject           String?
  payload           Json
  dedupeKey         String              @unique @map("dedupe_key")
  attempts          Int                 @default(0)
  error             String?
  providerMessageId String?             @map("provider_message_id")
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz(3)
  readAt            DateTime?           @map("read_at") @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  salon Salon? @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([salonId, createdAt])
  @@index([bookingId])
  @@index([userId, channel, readAt])
  @@index([status, channel])
  @@map("notifications")
}
